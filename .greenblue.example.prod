# Production blue-green at /var/www/go.amtgard.com. Copy to .greenblue (do not commit).
#
#   sudo /var/gb/generic-green-blue-deployment/bin/gb /var/www/go.amtgard.com deploy
#   sudo /var/gb/generic-green-blue-deployment/bin/gb /var/www/go.amtgard.com revert
#
# First deploy: legacy container "go" is still running, so gb bootstraps
# green, flips host nginx to green, then stops the legacy container. The old slot
# stays running afterwards for `gb revert`.
# Host nginx templates preserve the current Certbot TLS (cert paths are in the
# template, not the live site file). If cert paths ever change, update the
# templates here, not just the live site file - gb overwrites it on each deploy.
# Before the first gb deploy after this merges: the live go checkout still
# carries this branch's index.php change uncommitted, which would block gb's
# pull --ff-only. Discard it first (it is identical to merged main):
#   sudo -u www-data git -C /var/www/go.amtgard.com checkout -- index.php

GB_MODE="prod"

GB_PROJECT_NAME="amtgard-go"
GB_CONTAINER_APP_DIR="/var/www/go.amtgard.com"
GB_COMPOSE_SERVICE="app"

GB_LEGACY_CONTAINER="go"
GB_BLUE_CONTAINER="go-blue"
GB_GREEN_CONTAINER="go-green"
GB_BLUE_PORT="32080"
GB_GREEN_PORT="32081"

GB_WEB_COMPOSE_PROJECT="amtgard-go"
GB_WEB_COMPOSE_BASE="docker/compose.prod.yml"
GB_WEB_COMPOSE_SLOT="docker/compose.%slot%.yml"
GB_STATE_DIR="/var/lib/amtgard-go"

GB_NGINX_STRATEGY="site-file"
GB_NGINX_SITE_NAME="go.amtgard.com"
GB_NGINX_TEMPLATE="host/nginx.%slot%.conf"

GB_DEPLOY_STACKS="web"
GB_APP_INSTALL="none"
GB_GIT_BRANCH="main"
